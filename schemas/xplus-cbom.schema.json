{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cerebro-one/schemas/xplus-cbom.schema.json",
  "title": "CEREBRO ONE – XPLUS Component Bill of Materials",
  "description": "Schema for validating CBOM (Component Bill of Materials) payloads in the CEREBRO ONE AI pipeline.",
  "type": "object",
  "required": [
    "cbom_version",
    "pipeline_id",
    "components",
    "metadata"
  ],
  "additionalProperties": false,
  "properties": {
    "cbom_version": {
      "type": "string",
      "description": "SemVer-style CBOM schema version.",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "pipeline_id": {
      "type": "string",
      "description": "Unique identifier for the pipeline run.",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "required": [
        "created_at",
        "environment",
        "signed_by"
      ],
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "environment": {
          "type": "string",
          "enum": [
            "dev",
            "staging",
            "production"
          ]
        },
        "signed_by": {
          "type": "string",
          "description": "Identity of the signing actor (email or service account)."
        },
        "signature": {
          "type": "string",
          "description": "Base64-encoded artifact signature."
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "version",
          "type",
          "trust_level"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique component identifier (UUID or slug).",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "type": {
            "type": "string",
            "enum": [
              "model",
              "data-source",
              "service",
              "library",
              "plugin"
            ]
          },
          "trust_level": {
            "type": "string",
            "enum": [
              "untrusted",
              "verified",
              "signed",
              "attested"
            ],
            "description": "Zero Trust classification for this component."
          },
          "hash": {
            "type": "string",
            "description": "SHA-256 content hash of the component artifact.",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_uri": {
            "type": "string",
            "format": "uri"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of component IDs this component depends on."
          }
        }
      }
    },
    "zero_trust": {
      "type": "object",
      "description": "Zero Trust policy assertions for this CBOM.",
      "properties": {
        "policy_version": {
          "type": "string"
        },
        "all_components_verified": {
          "type": "boolean"
        },
        "attestation_required": {
          "type": "boolean"
        },
        "network_policy": {
          "type": "string",
          "enum": [
            "deny-all",
            "allow-verified-only",
            "allow-attested-only"
          ]
        }
      }
    }
  }
}